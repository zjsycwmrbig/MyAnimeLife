{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/anime.schema.json",
  "title": "Anime record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "rating",
    "review",
    "coverUrl",
    "note",
    "externalIds",
    "match",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "rating": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "type": "string",
      "maxLength": 20000
    },
    "coverUrl": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 5000
    },
    "externalIds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bangumi": {
          "type": "string",
          "minLength": 1
        },
        "bilibiliMedia": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "bilibiliSeason": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "anilist": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "mal": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "source",
        "confidence",
        "matchedTitle",
        "matchedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "matched",
            "manual",
            "unmatched"
          ]
        },
        "method": {
          "enum": [
            "site-id",
            "title-exact",
            "title-fuzzy",
            "ai",
            "manual",
            "import"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matchedTitle": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "matchedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deletedAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
