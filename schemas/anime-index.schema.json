{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/anime-index.schema.json",
  "title": "Anime index record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "aliases",
    "rating",
    "reviewExcerpt",
    "coverUrl",
    "externalIds",
    "season",
    "match",
    "createdAt",
    "updatedAt",
    "deletedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "aliases": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "rating": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewExcerpt": {
      "type": "string",
      "maxLength": 180
    },
    "coverUrl": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "externalIds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bangumi": {
          "type": "string",
          "minLength": 1
        },
        "bilibiliMedia": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "bilibiliSeason": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "anilist": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "mal": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "season": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "number",
            "label",
            "year"
          ],
          "properties": {
            "key": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "number": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                },
                {
                  "type": "null"
                }
              ]
            },
            "label": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "year": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2200
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "confidence",
        "matchedTitle"
      ],
      "properties": {
        "status": {
          "enum": [
            "matched",
            "manual",
            "unmatched"
          ]
        },
        "method": {
          "enum": [
            "site-id",
            "title-exact",
            "title-fuzzy",
            "ai",
            "manual",
            "import"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matchedTitle": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deletedAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
