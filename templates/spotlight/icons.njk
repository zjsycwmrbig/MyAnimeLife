{% macro icon(name, className="") -%}
<svg class="icon {{ className }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if name == "archive" %}
    <rect width="20" height="5" x="2" y="3" rx="1"></rect>
    <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path>
    <path d="M10 12h4"></path>
  {% elif name == "search" %}
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  {% elif name == "x" %}
    <path d="M18 6 6 18"></path>
    <path d="m6 6 12 12"></path>
  {% elif name == "star" %}
    <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
  {% elif name == "external" %}
    <path d="M15 3h6v6"></path>
    <path d="M10 14 21 3"></path>
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
  {% elif name == "arrow-left" %}
    <path d="m12 19-7-7 7-7"></path>
    <path d="M19 12H5"></path>
  {% elif name == "chevron-left" %}
    <path d="m15 18-6-6 6-6"></path>
  {% elif name == "chevron-right" %}
    <path d="m9 18 6-6-6-6"></path>
  {% elif name == "database" %}
    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
    <path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
    <path d="M3 12a9 3 0 0 0 18 0"></path>
  {% elif name == "pencil" %}
    <path d="M21.2 6.8a2.8 2.8 0 0 0-4-4L3 17v4h4L21.2 6.8z"></path>
    <path d="m15 5 4 4"></path>
  {% elif name == "sparkle" %}
    <path d="m12 3-1.9 5.1a2 2 0 0 1-1.2 1.2L4 11.2l4.9 1.9a2 2 0 0 1 1.2 1.2L12 19.4l1.9-5.1a2 2 0 0 1 1.2-1.2l4.9-1.9-4.9-1.9a2 2 0 0 1-1.2-1.2L12 3z"></path>
  {% elif name == "share" %}
    <circle cx="18" cy="5" r="3"></circle>
    <circle cx="6" cy="12" r="3"></circle>
    <circle cx="18" cy="19" r="3"></circle>
    <path d="m8.6 13.5 6.8 4"></path>
    <path d="m15.4 6.5-6.8 4"></path>
  {% elif name == "download" %}
    <path d="M12 3v12"></path>
    <path d="m7 10 5 5 5-5"></path>
    <path d="M5 21h14"></path>
  {% elif name == "copy" %}
    <rect x="9" y="9" width="11" height="11" rx="2"></rect>
    <path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"></path>
  {% endif %}
</svg>
{%- endmacro %}
