{% extends "base.njk" %}
{% from "icons.njk" import icon %}

{% block bodyClass %}insights-page compare-page{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ assetRoot }}insights.css?v={{ assetVersion }}" />
{% endblock %}

{% block content %}
  <section class="insights-hero-band" aria-labelledby="compare-title">
    <div class="page-shell insights-hero compare-hero">
      <div class="insights-heading">
        <p class="eyebrow">TASTE MATCH / 同好对比</p>
        <h1 id="compare-title">看看你们的看番品味有多接近</h1>
        <p>把两份公开档案放在一起，比较收藏重合、年代偏好、评分习惯和数据完整度。</p>
        <a class="compare-back-link" href="{{ homeUrl }}insights/">返回数据洞察</a>
      </div>
      <dl class="insights-snapshot" aria-label="对比说明">
        <div><dt>匹配依据</dt><dd>稳定 ID</dd></div>
        <div><dt>季度处理</dt><dd>相互独立</dd></div>
        <div><dt>读取内容</dt><dd>公开索引</dd></div>
        <div><dt>数据处理</dt><dd>仅本地</dd></div>
      </dl>
    </div>
  </section>

  <main
    id="repository-compare"
    class="page-shell compare-main"
    aria-labelledby="compare-main-title"
    data-own-repository="{{ repository.slug }}"
    data-own-branch="{{ repository.branch }}"
    data-current-data-url="{{ currentDataUrl }}"
  >
    <div class="compare-page-heading">
      <div>
        <p class="section-index">01 / TASTE MATCH</p>
        <h2 id="compare-main-title">找到一位同好，看看彼此的口味</h2>
      </div>
      <button
        id="shareComparison"
        class="insights-secondary-button"
        type="button"
        data-share-trigger
        data-share-kind="comparison"
        aria-haspopup="dialog"
        disabled
      >
        {{ icon("share") }}
        <span>分享对比结果</span>
      </button>
    </div>

    <div class="compare-layout">
      <div class="compare-copy">
        <p>当前档案：<strong>{{ repository.slug or "尚未配置 GitHub 仓库" }}</strong></p>
        <p>使用双方索引中的稳定 ID 匹配，不同季度会保留为独立作品。</p>
      </div>
      <form id="compareForm" class="compare-form">
        <label>
          <span>另一位同好的公开仓库</span>
          <input id="peerRepository" name="peer" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="owner/repository" maxlength="201" required />
        </label>
        <label>
          <span>分支</span>
          <input id="peerBranch" name="branch" type="text" autocomplete="off" spellcheck="false" value="main" maxlength="200" required />
        </label>
        <button id="compareSubmit" class="insights-primary-button" type="submit">开始对比</button>
      </form>
    </div>
    <p id="compareStatus" class="compare-status" role="status" aria-live="polite">输入公开仓库地址后读取对方的轻量索引。</p>

    <div id="compareResults" class="compare-results" hidden>
      <div class="compare-scoreboard">
        <div>
          <span>当前档案</span>
          <strong id="currentTotal">0</strong>
          <small id="currentAverage">均分 —</small>
          <small id="currentCoverage">评分覆盖 —</small>
        </div>
        <div class="overlap-score">
          <span>共同收藏</span>
          <strong id="sharedTotal">0</strong>
          <small id="overlapPercent">重合率 0%</small>
          <span class="overlap-track" aria-hidden="true"><span id="overlapBar"></span></span>
        </div>
        <div>
          <span>对方档案</span>
          <strong id="peerTotal">0</strong>
          <small id="peerAverage">均分 —</small>
          <small id="peerCoverage">评分覆盖 —</small>
        </div>
      </div>

      <div class="compare-result-toolbar">
        <div>
          <p class="section-index">02 / MATCH REPORT</p>
          <h3 id="compare-report-title">你们的口味报告</h3>
        </div>
        <nav class="insights-tabs compare-tabs" role="tablist" aria-label="对比结果模块">
          <button class="insight-tab is-active" id="compare-tab-overview" type="button" role="tab" aria-selected="true" aria-controls="compare-panel-overview" data-compare-tab="overview">概览</button>
          <button class="insight-tab" id="compare-tab-overlap" type="button" role="tab" aria-selected="false" aria-controls="compare-panel-overlap" data-compare-tab="overlap">重合收藏</button>
          <button class="insight-tab" id="compare-tab-years" type="button" role="tab" aria-selected="false" aria-controls="compare-panel-years" data-compare-tab="years">年代构成</button>
          <button class="insight-tab" id="compare-tab-ratings" type="button" role="tab" aria-selected="false" aria-controls="compare-panel-ratings" data-compare-tab="ratings">评分习惯</button>
          <button class="insight-tab" id="compare-tab-taste" type="button" role="tab" aria-selected="false" aria-controls="compare-panel-taste" data-compare-tab="taste">口味标签</button>
          <button class="insight-tab" id="compare-tab-completeness" type="button" role="tab" aria-selected="false" aria-controls="compare-panel-completeness" data-compare-tab="completeness">档案完整度</button>
        </nav>
      </div>

      <section class="compare-tab-panel is-active" id="compare-panel-overview" role="tabpanel" aria-labelledby="compare-tab-overview" data-compare-panel="overview">
        <div class="compare-metric-grid">
          <article><span>仅你收藏</span><strong id="currentOnlyMetric">0</strong><small>部独有作品</small></article>
          <article><span>仅对方收藏</span><strong id="peerOnlyMetric">0</strong><small>部待发现作品</small></article>
          <article><span>共同评分</span><strong id="sharedRatedMetric">0</strong><small>部可比较评分</small></article>
          <article class="is-accent"><span>平均分差</span><strong id="ratingGapMetric">—</strong><small>共同评分作品</small></article>
        </div>
        <div class="compare-overview-grid">
          <article class="compare-data-panel">
            <div class="compare-list-heading"><h3>档案速览</h3><span>当前 / 对方</span></div>
            <div id="compareOverviewPairs" class="compare-pair-list"></div>
          </article>
          <article class="compare-data-panel compare-discovery-card">
            <div class="compare-list-heading"><h3>最值得交换的收藏</h3><span>按评分优先</span></div>
            <div id="compareDiscoveryList" class="compare-discovery-list"></div>
          </article>
        </div>
      </section>

      <section class="compare-tab-panel" id="compare-panel-overlap" role="tabpanel" aria-labelledby="compare-tab-overlap" data-compare-panel="overlap" hidden>
        <div class="compare-panel-intro">
          <div><p class="section-index">COLLECTION CHEMISTRY</p><h3>共同收藏与各自发现</h3></div>
          <p>作品先按记录 ID，再按 Bangumi、Bilibili、AniList、MAL 等稳定外部 ID 匹配。</p>
        </div>
        <div class="compare-lists">
          <article>
            <div class="compare-list-heading"><h3>共同收录</h3><span id="sharedCount">0</span></div>
            <div id="sharedList" class="compare-list"></div>
          </article>
          <article>
            <div class="compare-list-heading"><h3>仅当前档案</h3><span id="currentOnlyCount">0</span></div>
            <div id="currentOnlyList" class="compare-list"></div>
          </article>
          <article>
            <div class="compare-list-heading"><h3>仅对方档案</h3><span id="peerOnlyCount">0</span></div>
            <div id="peerOnlyList" class="compare-list"></div>
          </article>
        </div>
      </section>

      <section class="compare-tab-panel" id="compare-panel-years" role="tabpanel" aria-labelledby="compare-tab-years" data-compare-panel="years" hidden>
        <div class="compare-metric-grid compare-year-preference-summary">
          <article><span>你更偏爱</span><strong id="currentPreferredDecade">—</strong><small id="currentPreferredDecadeMeta">暂无年代数据</small></article>
          <article><span>对方更偏爱</span><strong id="peerPreferredDecade">—</strong><small id="peerPreferredDecadeMeta">暂无年代数据</small></article>
          <article class="is-accent"><span>最大偏好差</span><strong id="decadePreferenceGap">—</strong><small id="decadePreferenceGapMeta">比较双方年代占比</small></article>
        </div>
        <section class="compare-data-panel compare-decade-panel" aria-labelledby="compare-decades-title">
          <div class="compare-list-heading">
            <div><h3 id="compare-decades-title">年代偏好对照</h3><p>按双方年代占比差异从大到小排列</p></div>
            <span>当前 / 对方</span>
          </div>
          <div id="compareDecades" class="compare-preference-bars"></div>
        </section>
        <p class="compare-footnote">仅统计已标注作品年代的收藏；占比按各自已标注年代的作品总数计算，不从作品数量直接推断偏好。</p>
      </section>

      <section class="compare-tab-panel" id="compare-panel-ratings" role="tabpanel" aria-labelledby="compare-tab-ratings" data-compare-panel="ratings" hidden>
        <article class="compare-extreme-diff">
          <div><span>最大单作评分差</span><strong id="maxRatingDifference">—</strong></div>
          <div><h3 id="maxRatingDifferenceTitle">还没有可比较的共同评分</h3><p id="maxRatingDifferenceCopy">双方都评分后，这里会显示分歧最大的共同作品。</p></div>
        </article>
        <div class="compare-rating-summary">
          <article><span>你的均分</span><strong id="ratingCurrentAverage">—</strong></article>
          <article><span>对方均分</span><strong id="ratingPeerAverage">—</strong></article>
          <article class="is-current"><span>你评分更高</span><strong id="currentHigherCount">0</strong></article>
          <article class="is-peer"><span>对方评分更高</span><strong id="peerHigherCount">0</strong></article>
          <article><span>评分相同</span><strong id="tiedRatingCount">0</strong></article>
        </div>
        <div class="compare-insight-grid">
          <section class="compare-data-panel" aria-labelledby="compare-ratings-title">
            <div class="compare-list-heading"><h3 id="compare-ratings-title">评分区间</h3><span>包含未评分</span></div>
            <div id="compareRatings" class="compare-bars"></div>
          </section>
          <section class="compare-data-panel rating-differences">
            <div class="compare-list-heading">
              <h3>共同作品评分差</h3>
              <span id="ratingDifferenceSummary">只计入双方都已评分</span>
            </div>
            <div id="ratingDifferenceList" class="rating-difference-list"></div>
          </section>
        </div>
      </section>

      <section class="compare-tab-panel" id="compare-panel-taste" role="tabpanel" aria-labelledby="compare-tab-taste" data-compare-panel="taste" hidden>
        <div class="compare-panel-intro">
          <div><p class="section-index">TAG CHEMISTRY</p><h3>你们会被哪些标签吸引</h3></div>
          <p id="compareTasteStatus">正在读取双方公开 Bangumi 缓存。缺少缓存时会明确提示，不会推测标签。</p>
        </div>
        <div class="compare-taste-grid">
          <article class="compare-data-panel compare-radar-panel">
            <div class="compare-list-heading"><h3>标签偏好雷达</h3><span>双方共同热门标签</span></div>
            <div id="compareTagRadar" class="compare-tag-radar"></div>
            <div class="compare-radar-legend"><span class="is-current">当前档案</span><span class="is-peer">对方档案</span></div>
          </article>
          <article class="compare-data-panel compare-tag-deviation-panel">
            <div class="compare-list-heading"><h3>同标签评分差</h3><span>按平均分差排序</span></div>
            <div id="compareTagDeviations" class="compare-tag-deviations"></div>
          </article>
        </div>
      </section>

      <section class="compare-tab-panel" id="compare-panel-completeness" role="tabpanel" aria-labelledby="compare-tab-completeness" data-compare-panel="completeness" hidden>
        <div class="compare-panel-intro">
          <div><p class="section-index">ARCHIVE SIGNALS</p><h3>两份档案记录得有多完整</h3></div>
          <p>只比较轻量索引中实际存在的字段，不推断缺失的全文评价或私人备注。</p>
        </div>
        <div id="compareCompleteness" class="compare-completeness"></div>
        <p class="compare-footnote">短评覆盖来自索引中保存的评价摘要；封面、年代、季度、外部 ID 和收录时间均按非空字段统计。</p>
      </section>
    </div>
    <script id="share-comparison-data" type="application/json">{}</script>
  </main>
{% endblock %}

{% block scripts %}
  <script src="{{ assetRoot }}share.js?v={{ assetVersion }}" defer></script>
  <script src="{{ assetRoot }}insights.js?v={{ assetVersion }}" defer></script>
{% endblock %}
