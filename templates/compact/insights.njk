{% extends "base.njk" %}
{% from "icons.njk" import icon %}

{% block bodyClass %}insights-page{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ assetRoot }}insights.css?v={{ assetVersion }}" />
{% endblock %}

{% block content %}
  <section class="insights-hero-band" aria-labelledby="insights-title">
    <div class="page-shell insights-hero">
      <div class="insights-heading">
        <p class="eyebrow">INSIGHTS / 数据洞察</p>
        <h1 id="insights-title">档案的轨迹</h1>
        <p>从收录节奏、年代构成与评分分布，观察这份私人档案的变化。</p>
        <button
          class="share-trigger insights-share-trigger"
          data-share-trigger
          data-share-kind="overview"
          type="button"
          aria-haspopup="dialog"
          title="选择模块并导出档案洞察图"
        >
          {{ icon("share") }}
          <span>分享洞察图</span>
        </button>
      </div>
      <dl class="insights-snapshot" aria-label="档案摘要">
        <div>
          <dt>作品总数</dt>
          <dd>{{ insights.summary.total }}</dd>
        </div>
        <div>
          <dt>平均评分</dt>
          <dd>{{ insights.summary.averageRating }}</dd>
        </div>
        <div>
          <dt>评分覆盖</dt>
          <dd>{{ insights.summary.ratedPercent }}%</dd>
        </div>
        <div>
          <dt>本月新增</dt>
          <dd>{{ insights.summary.latestMonth }}</dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="page-shell insights-shell">
    {% if insights.summary.total %}
      <section class="insights-overview" aria-labelledby="overview-title">
        <div class="section-heading">
          <div>
            <p class="section-index">01 / OVERVIEW</p>
            <h2 id="overview-title">收录概览</h2>
          </div>
          <p>按记录创建时间统计</p>
        </div>

        <div class="window-grid">
          {% for window in insights.windows %}
            <article class="window-stat">
              <span>{{ window.label }}</span>
              <strong>{{ window.count }}</strong>
              <small>部新增</small>
            </article>
          {% endfor %}
          <article class="window-stat window-stat-accent">
            <span>季度信息覆盖</span>
            <strong>{{ insights.summary.seasonPercent }}%</strong>
            <small>有年代数据</small>
          </article>
        </div>
      </section>

      <div class="insights-grid">
        <article class="insight-panel insight-panel-wide" aria-labelledby="monthly-title">
          <div class="panel-heading">
            <div>
              <p class="section-index">02 / RHYTHM</p>
              <h2 id="monthly-title">最近十二个月</h2>
            </div>
            <span>新增收录</span>
          </div>
          <div class="month-chart" role="img" aria-label="最近十二个月新增收录柱状图">
            {% for month in insights.months %}
              <div class="month-column" title="{{ month.label }}：{{ month.count }} 部">
                <span class="month-value">{{ month.count }}</span>
                <span class="month-bar-track">
                  <span
                    class="month-bar{% if month.count == 0 %} is-empty{% endif %}"
                    style="--bar-size: {{ month.percent }}%"
                  ></span>
                </span>
                <span class="month-label">{{ month.shortLabel }}</span>
              </div>
            {% endfor %}
          </div>
        </article>

        <article class="insight-panel insight-panel-wide" aria-labelledby="decade-title">
          <div class="panel-heading">
            <div>
              <p class="section-index">03 / ERA</p>
              <h2 id="decade-title">年代分布</h2>
            </div>
            <span>{{ insights.summary.sourcePercent }}% 有外部索引</span>
          </div>
          <div class="distribution-list">
            {% for decade in insights.decades %}
              <div class="distribution-row">
                <span class="distribution-label">{{ decade.label }}</span>
                <span class="distribution-track">
                  <span
                    class="distribution-bar"
                    style="--bar-size: {{ decade.percent }}%"
                  ></span>
                </span>
                <span class="distribution-count">{{ decade.count }} 部</span>
                <span class="distribution-note">均分 {{ decade.averageRating }}</span>
              </div>
            {% endfor %}
          </div>
        </article>

        <article class="insight-panel" aria-labelledby="rating-title">
          <div class="panel-heading">
            <div>
              <p class="section-index">04 / SCORE</p>
              <h2 id="rating-title">评分分布</h2>
            </div>
            {{ icon("star") }}
          </div>
          <div class="rating-distribution">
            {% for rating in insights.ratings %}
              <div class="rating-row{% if rating.key == 'unrated' %} is-muted{% endif %}">
                <span>{{ rating.label }}</span>
                <span class="rating-track">
                  <span
                    class="rating-bar"
                    style="--bar-size: {{ rating.percent }}%"
                  ></span>
                </span>
                <strong>{{ rating.count }}</strong>
                <small>{{ rating.percent }}%</small>
              </div>
            {% endfor %}
          </div>
        </article>

        <article class="insight-panel" aria-labelledby="source-title">
          <div class="panel-heading">
            <div>
              <p class="section-index">05 / INDEX</p>
              <h2 id="source-title">索引覆盖</h2>
            </div>
            {{ icon("database") }}
          </div>
          {% if insights.sources.length %}
            <div class="source-stack">
              {% for source in insights.sources %}
                <div class="source-row">
                  <span>{{ source.label }}</span>
                  <span class="source-track">
                    <span
                      class="source-bar"
                      style="--bar-size: {{ source.percent }}%"
                    ></span>
                  </span>
                  <strong>{{ source.count }}</strong>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <p class="panel-empty">还没有可统计的站点索引。</p>
          {% endif %}
          {% if insights.bestDecade %}
            <div class="highlight-note">
              <span>平均评分最高年代</span>
              <strong>{{ insights.bestDecade.label }}</strong>
              <small>{{ insights.bestDecade.averageRating }} / 10</small>
            </div>
          {% endif %}
        </article>
      </div>
    {% else %}
      <section class="insights-empty" aria-labelledby="empty-title">
        <p class="section-index">01 / OVERVIEW</p>
        <h2 id="empty-title">档案还没有可统计的数据</h2>
        <p>添加第一部番剧后，这里会生成收录趋势、年代分布和评分分析。</p>
        <a class="insights-primary-link" href="{{ homeUrl }}">返回档案</a>
      </section>
    {% endif %}

    <section
      id="repository-compare"
      class="compare-section"
      aria-labelledby="compare-title"
      data-own-repository="{{ repository.slug }}"
      data-own-branch="{{ repository.branch }}"
      data-current-data-url="{{ currentDataUrl }}"
    >
      <div class="section-heading compare-heading">
        <div>
          <p class="section-index">06 / VERSUS</p>
          <h2 id="compare-title">仓库 PK</h2>
        </div>
        <button
          id="shareComparison"
          class="insights-secondary-button"
          type="button"
          {% if not repository.slug %}disabled{% endif %}
        >
          {{ icon("external") }}
          <span>分享 PK 邀请</span>
        </button>
      </div>

      <div class="compare-layout">
        <div class="compare-copy">
          <p>
            当前档案：
            <strong>{{ repository.slug or "尚未配置 GitHub 仓库" }}</strong>
          </p>
          <p>通过公开轻量索引匹配双方作品，不同季度按独立记录处理。</p>
        </div>

        <form id="compareForm" class="compare-form">
          <label>
            <span>对方仓库</span>
            <input
              id="peerRepository"
              name="peer"
              type="text"
              inputmode="url"
              autocomplete="off"
              spellcheck="false"
              placeholder="owner/repository"
              maxlength="201"
              required
            />
          </label>
          <label>
            <span>分支</span>
            <input
              id="peerBranch"
              name="branch"
              type="text"
              autocomplete="off"
              spellcheck="false"
              value="main"
              maxlength="200"
              required
            />
          </label>
          <button id="compareSubmit" class="insights-primary-button" type="submit">
            开始 PK
          </button>
        </form>
      </div>

      <p id="compareStatus" class="compare-status" role="status" aria-live="polite">
        输入公开仓库地址后读取对方轻量索引。
      </p>

      <div id="compareResults" class="compare-results" hidden>
        <div class="compare-scoreboard">
          <div>
            <span>当前档案</span>
            <strong id="currentTotal">0</strong>
            <small id="currentAverage">均分 —</small>
          </div>
          <div class="overlap-score">
            <span>共同收录</span>
            <strong id="sharedTotal">0</strong>
            <small id="overlapPercent">重合率 0%</small>
            <span class="overlap-track" aria-hidden="true">
              <span id="overlapBar"></span>
            </span>
          </div>
          <div>
            <span>对方档案</span>
            <strong id="peerTotal">0</strong>
            <small id="peerAverage">均分 —</small>
          </div>
        </div>

        <div class="compare-lists">
          <article>
            <div class="compare-list-heading">
              <h3>共同收录</h3>
              <span id="sharedCount">0</span>
            </div>
            <div id="sharedList" class="compare-list"></div>
          </article>
          <article>
            <div class="compare-list-heading">
              <h3>仅当前档案</h3>
              <span id="currentOnlyCount">0</span>
            </div>
            <div id="currentOnlyList" class="compare-list"></div>
          </article>
          <article>
            <div class="compare-list-heading">
              <h3>仅对方档案</h3>
              <span id="peerOnlyCount">0</span>
            </div>
            <div id="peerOnlyList" class="compare-list"></div>
          </article>
        </div>

        <div class="rating-differences">
          <div class="compare-list-heading">
            <h3>评分差最大</h3>
            <span>只计入双方都已评分的共同作品</span>
          </div>
          <div id="ratingDifferenceList" class="rating-difference-list"></div>
        </div>
      </div>
    </section>
  </div>
  <script id="share-insights-data" type="application/json">{{ insights | json }}</script>
{% endblock %}

{% block scripts %}
  <script src="{{ assetRoot }}share.js?v={{ assetVersion }}" defer></script>
  <script src="{{ assetRoot }}insights.js" defer></script>
{% endblock %}
