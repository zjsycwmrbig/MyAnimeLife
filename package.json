{
  "name": "myanimelife",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A GitHub Pages template and Tampermonkey client for a personal anime archive.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync:bangumi-public": "node scripts/sync-bangumi-public.mjs",
    "validate": "node scripts/validate.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "admin": "node scripts/admin.mjs",
    "test": "node --test tests/*.test.js",
    "test:userscript": "npm --prefix userscript test",
    "build:userscript": "npm --prefix userscript run build",
    "test:e2e:userscript": "npm --prefix userscript run test:e2e",
    "check": "npm test && npm run build",
    "check:all": "npm run check && npm run test:userscript && npm run build:userscript",
    "template:check": "node scripts/check-public-template.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "markdown-it": "^14.1.0",
    "nunjucks": "^3.2.4"
  }
}
